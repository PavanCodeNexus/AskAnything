# AskAnything Environment Configuration

# Groq Cloud API Key (Required for Llama 3.3 70B RAG generation & query rewriting)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq Model (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# ChromaDB Persistence Directory
CHROMA_PERSIST_DIR=./chroma_db

# HuggingFace Embedding Model (local sentence-transformers)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Optional Tesseract OCR Executable Path (Auto-detected on Windows if omitted)
# TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
